{
  "name": "favorsite-extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local-First Chrome extension for organizing native bookmarks with previewable, reversible workflows and optional local AI.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:mcp": "node --test tests/mcp/bridge.test.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "prepare:semantic-model": "node scripts/prepare-semantic-model.mjs",
    "verify:semantic-model": "node scripts/verify-semantic-model.mjs",
    "mcp:install": "node scripts/install-native-host.mjs",
    "mcp:package": "node scripts/package-mcp.mjs",
    "mcp": "node scripts/favorsite-mcp.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "minisearch": "^7.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/chrome": "^0.0.314",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@wxt-dev/module-react": "^1.1.3",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1",
    "wxt": "^0.20.6"
  }
}
