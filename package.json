{
  "name": "favorsite-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-First Chrome extension for organizing native bookmarks with previewable, reversible workflows and optional local AI.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate:icons": "node scripts/generate-icons.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "minisearch": "^7.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/chrome": "^0.0.314",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@wxt-dev/module-react": "^1.1.3",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1",
    "wxt": "^0.20.6"
  }
}
